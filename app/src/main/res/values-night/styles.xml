<resources>
    <color name="bg">#101C1A</color><color name="surface">#192925</color>
    <color name="ink">#E4EFEB</color><color name="muted">#A0B7AF</color>
    <color name="line">#31463F</color><color name="accent">#81DEBC</color>
    <color name="soft">#203E34</color><color name="danger">#FFAAAA</color>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
